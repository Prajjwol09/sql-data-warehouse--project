/*
Script Purpose: This script creates views for the gold layer in the data warehouse. 
                The gold layer represents the final destination and fact tables (Star Schema)
*/

-- creating customer dimension table
create view gold.dim_Customer as									 -- creating view for the virtual table
select 
	row_number() over(order by cst_create_date) as customer_key,     -- used window function to create a surrogate key 
	ci.cst_id as customer_id,
	ci.cst_key as customer_number,
	ci.cst_firstname as first_name,
	ci.cst_lastname as last_name,
	elc.CNTRY as country,
	ci.cst_marital_status as marital_status,
	case
		when ci.cst_gndr != 'Unknown' then ci.cst_gndr
		else coalesce(eci.gen, 'Unknown')
	end as gender,
	eci.bdate as birth_Date,
	ci.cst_create_date as create_date
from silver.crm_customer_info as ci
left join silver.erp_cust_az12 as eci
on ci.cst_key = eci.cid
left join silver.erp_loc_a101 elc
on ci.cst_key = elc.cid;


-- creating product dimension table
create view gold.dim_product as								  -- creating views
select	
	row_number() over(order by prod_key) as product_key,      -- surrogate key
	p.prd_id as product_id,
	p.prod_key as product_number,
	p.prd_nm as product_name,
	p.category_id,
	ep.cat as category,
	ep.SUBCAT as sub_category,
	ep.maintenance,
	p.prd_cost as cost,
	p.prd_line as product_line,
	p.prd_Start_dt as start_date
from silver.crm_product_info p
left join silver.erp_px_cat_g1v2 ep
on p.category_id = ep.id
where p.prd_end_dt is null;                 -- filtering out the historical data, and returing the current data


-- creating fact table for sales (cuz it consists of transactions, measures, events, keys, dates)
create view gold.fact_sales as
select 
	sd.sls_ord_num as order_number,
	dp.product_key,                      -- dim_product's surrogate key
	dc.customer_key,					 -- dim_customer's surrogate key
	sd.sls_order_dt as order_date,					
	sd.sls_ship_dt as shipping_date,
	sd.sls_due_dt as due_date,
	sd.sls_sales as sales,
	sd.sls_quantity as quantity,
	sd.sls_price as price
from silver.crm_sales_Details sd
left join gold.dim_product dp
on sd.sls_prd_key = dp.product_number      -- connecting with the created surrogated key from dim_product dimension table
left join gold.dim_customer dc
on sd.sls_cust_id = dc.customer_id;      -- coonecting with the created surrogated key from dim_customer dimension table

